<Window
    x:Class="AtlasMasaWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AtlasMasaWindows.Models"
    mc:Ignorable="d"
    Title="Atlas Windows">

    <Grid Background="#070E1D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18,18,18,8" Padding="16" Background="#131E33" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Atlas / אטלס" Foreground="#F4F7FC" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock Text="Windows Local Life OS · Travel Design" Foreground="#BDCADF" FontSize="17" />
                    <TextBlock Text="{Binding PerformanceSummary}" Foreground="#95A5C4" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <Button Content="Toggle EN/HE" Command="{Binding ToggleLanguageCommand}" />
                    <Button Content="Refresh Execution" Command="{Binding RefreshExecutionCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabView Grid.Row="1" Margin="18,0,18,18" CanCloseTabs="False">
            <TabViewItem Header="Command Center">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Why this exists" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Atlas is built to help users execute with precision across life, work, and mobility, especially under pressure and uncertainty." TextWrapping="Wrap" Foreground="#D0DBEF" />
                                <TextBlock Text="This Windows build is local-first and tuned for high-end PCs using multi-worker queue orchestration and persistent state recovery." TextWrapping="Wrap" Foreground="#D0DBEF" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Daily execution check-in" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBox Header="Daily priority" Text="{Binding Session.DailyPriority, Mode=TwoWay}" />
                                <TextBox Header="Mid-term goal" Text="{Binding Session.MidTermGoal, Mode=TwoWay}" />
                                <TextBox Header="Long-term vision" Text="{Binding Session.LongTermVision, Mode=TwoWay}" />
                                <TextBox Header="Current blockers" Text="{Binding Session.Blockers, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox Header="Mood" SelectedItem="{Binding Session.Mood, Mode=TwoWay}" Width="220">
                                        <x:String>Focused</x:String>
                                        <x:String>Calm</x:String>
                                        <x:String>Overloaded</x:String>
                                        <x:String>Recovering</x:String>
                                        <x:String>Aggressive execution</x:String>
                                    </ComboBox>
                                    <TextBox Header="Energy (1-5)" Text="{Binding Session.Energy, Mode=TwoWay}" Width="180" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox Content="Went to gym today" IsChecked="{Binding Session.GymToday, Mode=TwoWay}" />
                                    <CheckBox Content="Made money today" IsChecked="{Binding Session.MoneyToday, Mode=TwoWay}" />
                                    <CheckBox Content="Memory opt-in" IsChecked="{Binding Session.MemoryOptIn, Mode=TwoWay}" />
                                </StackPanel>
                                <Button Content="Submit check-in" Command="{Binding SubmitCheckInCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Adaptive Survey">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Deep survey (branching-ready baseline)" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Questions map economic blockers, resilience factors, and growth opportunities. This is the intelligence substrate for the execution stream." TextWrapping="Wrap" Foreground="#D0DBEF" />
                                <TextBlock Text="{Binding SurveyProgressText}" Foreground="#98A9C7" />
                                <TextBlock Text="{Binding SurveyCompletionLine}" Foreground="#9AB0CF" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding CurrentSurveyQuestion.Title}" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding CurrentSurveyQuestion.Description}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <ListView ItemsSource="{Binding CurrentSurveyChoices}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SurveyChoice">
                                            <Button
                                                Margin="0,3,0,3"
                                                Content="{x:Bind Label}"
                                                Tag="{Binding}"
                                                Click="SurveyChoiceButton_Click" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{Binding SelectedSurveyAnswerLabel}" Foreground="#9AB0CF" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Prompt Queue">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Local reasoning queue (resumable)" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Queue persists to disk and resumes after app restart. High-end PCs process multiple queued prompts in parallel." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBox Header="Prompt" Text="{Binding NewPrompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74" />
                                <Button Content="Queue prompt" Command="{Binding EnqueuePromptCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <ListView ItemsSource="{Binding Queue}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:QueueRecord">
                                    <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind Prompt}" Foreground="#F4F7FC" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind Status}" Foreground="#A8BAD8" />
                                            <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind Progress, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind CheckpointNote}" Foreground="#9AB0CF" />
                                            <TextBlock Text="{x:Bind OutputSummary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind NextAction}" Foreground="#DDE8FA" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind ErrorMessage}" Foreground="#F7B0B5" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Execution Stream">
                <Grid>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Execution stream (survey-gated)" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="This output activates once deep survey baseline is complete." Foreground="#C8D6EE" />
                        <TextBlock Text="{Binding ExecutionAccessLine}" Foreground="#9FB2D2" />
                        <ListView ItemsSource="{Binding ExecutionFeed}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FeedItem">
                                    <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind Title}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind WhyNow}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind Priority}" Foreground="#8FB1FF" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Memory + Notes">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Capture note" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBox Header="Title" Text="{Binding NewNoteTitle, Mode=TwoWay}" />
                                <TextBox Header="Content" Text="{Binding NewNoteContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
                                <Button Content="Save note" Command="{Binding AddNoteCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Memory records" Foreground="#F4F7FC" FontSize="18" FontWeight="SemiBold" />
                        <ListView ItemsSource="{Binding Memory}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MemoryRecord">
                                    <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Type}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Value}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind Source}" Foreground="#9AB0CF" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Workspaces">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Notebook-style workspace sessions" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBox Header="Session title" Text="{Binding NewWorkspaceTitle, Mode=TwoWay}" />
                                <TextBox Header="Summary" Text="{Binding NewWorkspaceSummary, Mode=TwoWay}" AcceptsReturn="True" MinHeight="74" TextWrapping="Wrap" />
                                <Button Content="Create session" Command="{Binding AddWorkspaceSessionCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <ListView ItemsSource="{Binding Workspaces}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:WorkspaceSession">
                                    <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind Lane}" Foreground="#9AB0CF" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Access">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Passwordless-first access" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Windows local tier uses local state by default. Provider sign-in establishes identity for sync/cloud tiers later." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Sign in with Apple" Command="{Binding SignInAppleCommand}" />
                                    <Button Content="Sign in with Google" Command="{Binding SignInGoogleCommand}" />
                                    <Button Content="Sign in with Passkey" Command="{Binding SignInPasskeyCommand}" />
                                    <Button Content="Sign out" Command="{Binding SignOutCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Session.AccountLabel}" Foreground="#DCE7FA" FontSize="16" />
                                <TextBlock Text="{Binding Session.Provider}" Foreground="#9AB0CF" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="AI Guide">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#16263D" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="How Atlas AI is trained and why" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Training goals: economic empowerment, execution rigor, travel logistics, emergency continuity, and decision quality." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Model behavior: produce next-action plans with transparent constraints; avoid pretending certainty where signal is weak." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Safety boundary: Atlas is decision support, not a substitute for licensed professionals in high-stakes regulated domains." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Privacy boundary: local-first memory; user-controlled memory opt-in; explicit transparency in core workflows." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Mobility + Ops">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Mobility operations orientation" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Atlas treats mobility as infrastructure: uptime, safe harbor routing, continuity kits, and legal/safety constraints." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="This Windows app can stage plans for land/sea/air operations and sync with shared workspaces when cloud tier is enabled." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="System Output">
                <ListView ItemsSource="{Binding SystemOutput}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SystemLogLine">
                            <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind CreatedAt}" Foreground="#8DA4C7" FontSize="12" />
                                    <TextBlock Text="{x:Bind Text}" Foreground="#DCE7FA" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
