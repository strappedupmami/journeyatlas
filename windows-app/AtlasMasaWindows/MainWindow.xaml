<Window
    x:Class="AtlasMasaWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AtlasMasaWindows.Models"
    mc:Ignorable="d"
    Title="Atlas Windows">

    <Grid x:Name="RootGrid" Background="#070E1D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18,18,18,8" Padding="16" Background="#131E33" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Atlas / אטלס" Foreground="#F4F7FC" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock Text="Windows Local Life OS · Travel Design" Foreground="#BDCADF" FontSize="17" />
                    <TextBlock Text="{Binding PerformanceSummary}" Foreground="#95A5C4" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <Button Content="Toggle EN/HE" Command="{Binding ToggleLanguageCommand}" />
                    <Button Content="Refresh Execution" Command="{Binding RefreshExecutionCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabView Grid.Row="1" Margin="18,0,18,18" CanCloseTabs="False">
            <TabViewItem Header="Command Center">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14" Visibility="{x:Bind BoolVisibility(ViewModel.ShouldShowLocalAiSetupExperience), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding RuntimeHealthHeadline}" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="BlackHaven will install and prepare local AI directly in the app. No Terminal, no manual model commands, and no confusing runtime logs." TextWrapping="WrapWholeWords" Foreground="#D0DBEF" />
                                <TextBlock Text="{Binding PerformanceSummary}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Choose local models to install" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                <ListView ItemsSource="{Binding LocalAIInstallOptions}" SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:LocalAIModelInstallOption">
                                            <CheckBox
                                                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                Checked="LocalAiInstallOption_Checked"
                                                Unchecked="LocalAiInstallOption_Unchecked">
                                                <StackPanel Orientation="Vertical" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind RecommendedLabel}" Foreground="#FFC857" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Subtitle}" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{x:Bind ModelName}" Foreground="#9AB0CF" />
                                                    <TextBlock Text="{x:Bind ApproximateSizeLabel}" Foreground="#9AB0CF" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{Binding SelectedLocalAiInstallSummary}" Foreground="#9AB0CF" />
                                <TextBlock Text="{Binding LocalModelRuntimeDetail}" Foreground="#BFD0EB" TextWrapping="WrapWholeWords" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding LocalModelRuntimeProgress}" Height="8" Foreground="#44C7FF" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="{Binding LocalAiPrimaryActionTitle}" Command="{Binding InstallLocalAiCommand}" />
                                    <Button Content="Repair / Retry" Command="{Binding RetryLocalAiSetupCommand}" />
                                    <Button Content="Set Up Later" Command="{Binding DeferLocalAiSetupCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding RuntimeEndpointReachabilityLine}" Foreground="#8FA4C4" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14" Visibility="{x:Bind InverseBoolVisibility(ViewModel.ShouldShowLocalAiSetupExperience), Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Welcome to BlackHaven" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="To get started on wealth building and life improvement, complete the adaptive deep survey and use local AI to build your execution stream." TextWrapping="Wrap" Foreground="#D0DBEF" />
                                <TextBlock Text="Windows is now local-first with Rust-backed reasoning, adaptive survey intelligence, and embedded execution guidance in Command." TextWrapping="Wrap" Foreground="#D0DBEF" />
                                <TextBlock Text="{Binding IntelligenceCoverageLine}" Foreground="#9AB0CF" />
                                <TextBlock Text="{Binding ExecutionAccessLine}" Foreground="#9AB0CF" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#0E1A2B"
                            CornerRadius="10"
                            Padding="12"
                            Visibility="{x:Bind RuntimeStripVisibility(ViewModel.ShowRuntimeProgressStrip), Mode=OneWay}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding LocalModelRuntimeStatus}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LocalModelRuntimeDetail}" Foreground="#BFD0EB" TextWrapping="WrapWholeWords" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding LocalModelRuntimeProgress}" Height="8" Foreground="#44C7FF" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LocalModelDownloadSizeText}" Foreground="#9FB2D2" />
                                    <TextBlock Text="  •  " Foreground="#7F95B7" />
                                    <TextBlock Text="{Binding LocalModelDownloadEtaText}" Foreground="#9FB2D2" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14" Visibility="{x:Bind InverseBoolVisibility(ViewModel.ShouldShowLocalAiSetupExperience), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Desktop Remote Control" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Turn this desktop into the always-on home base for remote phone-to-desktop work, local-first file delivery, and long-running AI workloads you can power yourself." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Keep the machine on and plugged in, pair your phone over your own network, and route files into your own computer without depending on a cloud relay or full-time internet access." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Built for privacy, resilience, emergency prep, and energy control: pair BlackHaven with home backup power plus renewable generation so heavy local AI can keep running during outages and unstable network conditions." Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Recommended setup: solar or wind generation plus a home battery/backup system. Founder recommendation: EcoFlow Delta Pro 3." Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding RemoteControlStatus}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding RemoteControlUrl}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                <TextBox Header="Pairing token" Text="{Binding RemoteControlToken, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Text="{Binding RemoteControlLastAction}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                <Button Content="Regenerate token" Command="{Binding RegenerateRemoteControlTokenCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14" Visibility="{x:Bind InverseBoolVisibility(ViewModel.ShouldShowLocalAiSetupExperience), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Atlas Concierge" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Send a message and get a local-first answer with visible thought-process summaries." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding LocalAiChatStatusMessage}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" Visibility="{x:Bind TextVisibility(ViewModel.LocalAiChatStatusMessage), Mode=OneWay}" />
                                <TextBox
                                    Header="Message concierge"
                                    Text="{Binding NewPrompt, Mode=TwoWay}"
                                    KeyDown="ConciergePrompt_KeyDown"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="96"
                                    PlaceholderText="Ask Atlas for tactical guidance, planning, execution help, or life/logistics support." />
                                <Button Content="Send" Command="{Binding EnqueuePromptCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14" Visibility="{x:Bind InverseBoolVisibility(ViewModel.ShouldShowLocalAiSetupExperience), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Execution Stream Window" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="This stream stays in Command so the user sees what matters without bouncing between tabs." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding ExecutionAccessLine}" Foreground="#9FB2D2" />
                                <ListView ItemsSource="{Binding ExecutionFeed}" MaxHeight="260">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:FeedItem">
                                            <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{x:Bind Title}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{x:Bind WhyNow}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{x:Bind Priority}" Foreground="#8FB1FF" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14" Visibility="{x:Bind InverseBoolVisibility(ViewModel.ShouldShowLocalAiSetupExperience), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="State-Aware Execution" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding OperatorStateSnapshot.Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding OperatorStateSnapshot.NextAction}" Foreground="#F4F7FC" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding OperatorStateSnapshot.Rationale}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding CurrentSupportRecommendation.Title}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentSupportRecommendation.Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding CurrentSupportRecommendation.BodyDoublingPrompt}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Refresh Support" Command="{Binding RefreshSupportRecommendationCommand}" />
                                    <Button Content="Generate Activity" Command="{Binding GenerateActivitySuggestionCommand}" />
                                    <Button Content="Generate Itinerary" Command="{Binding GenerateItineraryPlanCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14" Visibility="{x:Bind InverseBoolVisibility(ViewModel.ShouldShowLocalAiSetupExperience), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Checklist + Itinerary Hub" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveChecklistPlan.Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <Button Content="Generate Checklist" Command="{Binding GenerateChecklistPlanCommand}" HorizontalAlignment="Left" />
                                <ListView ItemsSource="{Binding ActiveChecklistPlan.Steps}" MaxHeight="320">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChecklistStep">
                                            <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Button Content="Toggle" Command="{Binding DataContext.ToggleChecklistStepCommand, ElementName=RootGrid}" CommandParameter="{Binding}" />
                                                        <TextBlock Text="{x:Bind Title}" Foreground="#F4F7FC" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Rationale}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{x:Bind Instructions}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                                    <TextBox Header="Notes" Text="{x:Bind Notes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{Binding CurrentActivitySuggestion.Title}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentActivitySuggestion.DurationLabel}" Foreground="#8FB1FF" />
                                <TextBlock Text="{Binding CurrentActivitySuggestion.Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding CurrentItineraryPlan.Title}" Foreground="#F4F7FC" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{Binding CurrentItineraryPlan.Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ItineraryStep">
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{x:Bind TimeLabel}" Foreground="#8FB1FF" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Title}" Foreground="#F4F7FC" />
                                                <TextBlock Text="{x:Bind Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14" Visibility="{x:Bind InverseBoolVisibility(ViewModel.ShouldShowLocalAiSetupExperience), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Recent AI Responses" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <ListView ItemsSource="{Binding Queue}" MaxHeight="520">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:QueueRecord">
                                            <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{x:Bind Prompt}" Foreground="#F4F7FC" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{x:Bind CheckpointNote}" Foreground="#9AB0CF" Visibility="{x:Bind TextVisibility(CheckpointNote), Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind OutputSummary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" Visibility="{x:Bind TextVisibility(OutputSummary), Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind NextAction}" Foreground="#DDE8FA" TextWrapping="WrapWholeWords" Visibility="{x:Bind TextVisibility(NextAction), Mode=OneWay}" />
                                                    <Expander Header="Thought process" IsExpanded="False" Visibility="{x:Bind ReasoningVisibility(HasReasoningDetails), Mode=OneWay}">
                                                        <StackPanel Spacing="8" Padding="0,8,0,0">
                                                            <TextBlock Text="Why this answer" Foreground="#9FB2D2" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind ReasoningSummary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" Visibility="{x:Bind TextVisibility(ReasoningSummary), Mode=OneWay}" />
                                                            <TextBlock Text="Alternatives considered" Foreground="#9FB2D2" FontWeight="SemiBold" Visibility="{x:Bind ListVisibility(AlternativesConsidered), Mode=OneWay}" />
                                                            <ItemsControl ItemsSource="{x:Bind AlternativesConsidered}" Visibility="{x:Bind ListVisibility(AlternativesConsidered), Mode=OneWay}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <TextBlock Text="{Binding}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" Margin="0,0,0,4" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="Assumptions" Foreground="#9FB2D2" FontWeight="SemiBold" Visibility="{x:Bind ListVisibility(Assumptions), Mode=OneWay}" />
                                                            <ItemsControl ItemsSource="{x:Bind Assumptions}" Visibility="{x:Bind ListVisibility(Assumptions), Mode=OneWay}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <TextBlock Text="{Binding}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" Margin="0,0,0,4" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{x:Bind ConfidenceLabel}" Foreground="#8FB1FF" Visibility="{x:Bind TextVisibility(ConfidenceLabel), Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Expander>
                                                    <TextBlock Text="{x:Bind ErrorMessage}" Foreground="#F7B0B5" TextWrapping="WrapWholeWords" Visibility="{x:Bind TextVisibility(ErrorMessage), Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14" Visibility="{x:Bind InverseBoolVisibility(ViewModel.ShouldShowLocalAiSetupExperience), Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Daily execution check-in" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBox Header="Daily priority" Text="{Binding Session.DailyPriority, Mode=TwoWay}" />
                                <TextBox Header="Mid-term goal" Text="{Binding Session.MidTermGoal, Mode=TwoWay}" />
                                <TextBox Header="Long-term vision" Text="{Binding Session.LongTermVision, Mode=TwoWay}" />
                                <TextBox Header="Current blockers" Text="{Binding Session.Blockers, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox Header="Mood" SelectedItem="{Binding Session.Mood, Mode=TwoWay}" Width="220">
                                        <x:String>Focused</x:String>
                                        <x:String>Calm</x:String>
                                        <x:String>Overloaded</x:String>
                                        <x:String>Recovering</x:String>
                                        <x:String>Aggressive execution</x:String>
                                    </ComboBox>
                                    <TextBox Header="Energy (1-5)" Text="{Binding Session.Energy, Mode=TwoWay}" Width="180" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox Content="Went to gym today" IsChecked="{Binding Session.GymToday, Mode=TwoWay}" />
                                    <CheckBox Content="Made money today" IsChecked="{Binding Session.MoneyToday, Mode=TwoWay}" />
                                    <CheckBox Content="Memory opt-in" IsChecked="{Binding Session.MemoryOptIn, Mode=TwoWay}" />
                                </StackPanel>
                                <Button Content="Submit check-in" Command="{Binding SubmitCheckInCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Adaptive Survey">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Deep survey (branching-ready baseline)" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Questions map economic blockers, resilience factors, and growth opportunities. This is the intelligence substrate for the execution stream." TextWrapping="Wrap" Foreground="#D0DBEF" />
                                <TextBlock Text="{Binding LocalAiChatStatusMessage}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" Visibility="{x:Bind TextVisibility(ViewModel.LocalAiChatStatusMessage), Mode=OneWay}" />
                                <TextBlock Text="{Binding SurveyProgressText}" Foreground="#98A9C7" />
                                <TextBlock Text="{Binding SurveyCompletionLine}" Foreground="#9AB0CF" />
                                <TextBlock Text="{Binding IntelligenceCoverageLine}" Foreground="#9AB0CF" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding CurrentSurveyQuestion.Title}" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding CurrentSurveyQuestion.Description}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <StackPanel Visibility="{x:Bind SurveySingleVisibility(ViewModel.IsCurrentSurveyQuestionMulti), Mode=OneWay}">
                                    <ListView ItemsSource="{Binding CurrentSurveyChoices}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SurveyChoice">
                                                <Button
                                                    Margin="0,3,0,3"
                                                    Content="{x:Bind Label}"
                                                    Click="SurveyChoiceButton_Click" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <StackPanel Spacing="8" Visibility="{x:Bind SurveyMultiVisibility(ViewModel.IsCurrentSurveyQuestionMulti), Mode=OneWay}">
                                    <ItemsControl ItemsSource="{Binding CurrentSurveyChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SurveyChoice">
                                                <CheckBox
                                                    Content="{x:Bind Label}"
                                                    Checked="SurveyMultiChoice_Checked"
                                                    Unchecked="SurveyMultiChoice_Unchecked"
                                                    Margin="0,2,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding SurveyMultiSelectionLine}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                    <Button Content="Continue" Command="{Binding SubmitSurveyMultiChoiceCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedSurveyAnswerLabel}" Foreground="#9AB0CF" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Code">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Agentic coding workspace" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Code uses hybrid cloud routing when prepaid credits are active: Gemini 3.1 Pro Preview for frontend/UI exploration, GPT-5.4 for backend/build depth, with local Qwen still available on-device." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <Border Background="#18263F" CornerRadius="8" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding CodeAgentReadinessLine}" Foreground="#F4F7FC" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{Binding CodeAgentToolingLine}" Foreground="#BFD0EB" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{Binding CodeAgentContextLine}" Foreground="#8FA7CC" TextWrapping="WrapWholeWords" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Background="#3A1823"
                                    CornerRadius="8"
                                    Padding="10"
                                    Visibility="{x:Bind PrepaidLockedVisibility(ViewModel.Session.PrepaidCreditsActive), Mode=OneWay}">
                                    <TextBlock
                                        Text="Code Agent is locked. Activate prepaid credits to run coding tasks."
                                        Foreground="#F7B0B5"
                                        TextWrapping="WrapWholeWords" />
                                </Border>

                                <StackPanel
                                    Spacing="10"
                                    IsEnabled="{Binding Session.PrepaidCreditsActive}">
                                    <ComboBox Header="Agent route mode" SelectedItem="{Binding SelectedCodeAgentMode, Mode=TwoWay}" Width="280">
                                        <x:String>auto</x:String>
                                        <x:String>frontend_design</x:String>
                                        <x:String>backend_ops</x:String>
                                    </ComboBox>
                                    <TextBox
                                        Header="Agentic task"
                                        Text="{Binding CodePromptDraft, Mode=TwoWay}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="100"
                                        PlaceholderText="Describe the coding task, repo area, and expected result." />
                                    <Button Content="Run Code Agent task" Command="{Binding RunCodeAgentTaskCommand}" HorizontalAlignment="Left" />
                                </StackPanel>

                                <ToggleSwitch
                                    Header="Show traditional editor + terminal (optional)"
                                    IsOn="{Binding ShowClassicCodeTools, Mode=TwoWay}"
                                    IsEnabled="{Binding Session.PrepaidCreditsActive}" />

                                <StackPanel
                                    Spacing="8"
                                    Visibility="{x:Bind ClassicToolsVisibility(ViewModel.ShowClassicCodeTools), Mode=OneWay}">
                                    <TextBox
                                        Header="Classic scratchpad"
                                        Text="{Binding ClassicCodeScratchpad, Mode=TwoWay}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="96" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox
                                            Width="420"
                                            Header="Terminal command"
                                            Text="{Binding ClassicCodeCommandDraft, Mode=TwoWay}" />
                                        <Button
                                            VerticalAlignment="Bottom"
                                            Content="Run command"
                                            Command="{Binding RunClassicCodeCommandCommand}" />
                                    </StackPanel>
                                    <TextBox
                                        Header="Terminal output"
                                        Text="{Binding ClassicCodeCommandOutput}"
                                        IsReadOnly="True"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="120" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#0E1A2B"
                            CornerRadius="10"
                            Padding="12"
                            Visibility="{x:Bind RuntimeStripVisibility(ViewModel.ShowRuntimeProgressStrip), Mode=OneWay}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding LocalModelRuntimeStatus}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LocalModelRuntimeDetail}" Foreground="#BFD0EB" TextWrapping="WrapWholeWords" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding LocalModelRuntimeProgress}" Height="8" Foreground="#44C7FF" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LocalModelDownloadSizeText}" Foreground="#9FB2D2" />
                                    <TextBlock Text="  •  " Foreground="#7F95B7" />
                                    <TextBlock Text="{Binding LocalModelDownloadEtaText}" Foreground="#9FB2D2" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Code run history" Foreground="#F4F7FC" FontSize="18" FontWeight="SemiBold" />
                        <ListView ItemsSource="{Binding Queue}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:QueueRecord">
                                    <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind Prompt}" Foreground="#F4F7FC" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind CodeAgentRoute}" Foreground="#8FB1FF" />
                                            <TextBlock Text="{x:Bind Status}" Foreground="#A8BAD8" />
                                            <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind Progress, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind CheckpointNote}" Foreground="#9AB0CF" />
                                            <TextBlock Text="{x:Bind OutputSummary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind NextAction}" Foreground="#DDE8FA" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind ErrorMessage}" Foreground="#F7B0B5" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Execution Stream">
                <Grid>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Execution stream (survey-gated)" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="This output activates after the full intelligence coverage threshold is reached." Foreground="#C8D6EE" />
                        <TextBlock Text="{Binding ExecutionAccessLine}" Foreground="#9FB2D2" />
                        <TextBlock Text="{Binding IntelligenceCoverageLine}" Foreground="#9FB2D2" />
                        <ListView ItemsSource="{Binding ExecutionFeed}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FeedItem">
                                    <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind Title}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind WhyNow}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind Priority}" Foreground="#8FB1FF" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Memory + Notes">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Capture note" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBox Header="Title" Text="{Binding NewNoteTitle, Mode=TwoWay}" />
                                <TextBox Header="Content" Text="{Binding NewNoteContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
                                <Button Content="Save note" Command="{Binding AddNoteCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Background="#10192D" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Local Memory Vault" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Desktop keeps recent working context, compacted state-preserving summaries, and an encrypted local archive for exact recall. Lossless compaction stays on-device." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding MemoryVaultStatusLine}" Foreground="#A6B6D4" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding MemoryVaultPolicyLine}" Foreground="#8FB1FF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding MemoryVaultOverview}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBox Header="Recall from archive" Text="{Binding MemoryVaultRecallQuery, Mode=TwoWay}" PlaceholderText="Search raw local memory" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Compact further" Command="{Binding CompactMemoryVaultCommand}" />
                                    <Button Content="Deep archive" Command="{Binding DeepArchiveMemoryVaultCommand}" />
                                    <Button Content="Recall raw memory" Command="{Binding RecallMemoryVaultCommand}" />
                                    <Button Content="Delete local memory" Command="{Binding DeleteLocalMemoryCommand}" />
                                </StackPanel>
                                <ListView ItemsSource="{Binding MemoryVaultRecallResults}" MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:MemoryRecallHit">
                                            <Border Background="#121C30" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{x:Bind Summary}" Foreground="#F4F7FC" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{x:Bind SourceLabel}" Foreground="#9AB0CF" />
                                                    <TextBlock Text="{x:Bind MatchReason}" Foreground="#8FB1FF" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Memory records" Foreground="#F4F7FC" FontSize="18" FontWeight="SemiBold" />
                        <ListView ItemsSource="{Binding Memory}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MemoryRecord">
                                    <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Type}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Value}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind Source}" Foreground="#9AB0CF" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Workspaces">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Notebook-style workspace sessions" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBox Header="Session title" Text="{Binding NewWorkspaceTitle, Mode=TwoWay}" />
                                <TextBox Header="Summary" Text="{Binding NewWorkspaceSummary, Mode=TwoWay}" AcceptsReturn="True" MinHeight="74" TextWrapping="Wrap" />
                                <Button Content="Create session" Command="{Binding AddWorkspaceSessionCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <ListView ItemsSource="{Binding Workspaces}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:WorkspaceSession">
                                    <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Summary}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind Lane}" Foreground="#9AB0CF" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Access">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Passwordless-first access" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Windows local tier runs AI + memory on-device. Provider sign-in enables identity sync, and prepaid credits unlock optional cloud AI add-ons." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Sign-in opens a secure in-app browser window and only completes after backend session verification succeeds." Foreground="#A6B6D4" TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Sign in with Apple" Command="{Binding SignInAppleCommand}" />
                                    <Button Content="Sign in with Google" Command="{Binding SignInGoogleCommand}" />
                                    <Button Content="Sign in with Passkey" Command="{Binding SignInPasskeyCommand}" />
                                    <Button Content="Sign up with Passkey" Command="{Binding SignUpPasskeyCommand}" />
                                    <Button Content="Sign out" Command="{Binding SignOutCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AuthFlowStatusLine}" Foreground="#A6B6D4" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding Session.AccountLabel}" Foreground="#DCE7FA" FontSize="16" />
                                <TextBlock Text="{Binding Session.Provider}" Foreground="#9AB0CF" />
                                <TextBox Header="Shared backend API base" Text="{Binding BackendApiBaseDraft, Mode=TwoWay}" />
                                <Button Content="Save backend target" Command="{Binding SaveBackendConfigCommand}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Session.ApiBaseUrl}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="AI Guide">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,6,0,0">
                        <Border Background="#16263D" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="How Atlas AI is trained and why" Foreground="#F4F7FC" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Training goals: economic empowerment, execution rigor, travel logistics, emergency continuity, and decision quality." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Model behavior: produce next-action plans with transparent constraints; avoid pretending certainty where signal is weak." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Safety boundary: Atlas is decision support, not a substitute for licensed professionals in high-stakes regulated domains." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Privacy boundary: local-first memory; user-controlled memory opt-in; explicit transparency in core workflows." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Continuous adaptive questionnaire" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AdaptiveQuestionProgressLine}" Foreground="#A6B6D4" />
                                <TextBlock Text="{Binding Session.AdaptiveBusinessRuntimeStatusLine}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <CheckBox Content="Enable adaptive questions" IsChecked="{Binding Session.AdaptiveBusinessQuestionEngineEnabled, Mode=TwoWay}" />
                                    <CheckBox Content="Enable business autopilot" IsChecked="{Binding Session.BusinessAutopilotEnabled, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save runtime settings" Command="{Binding SaveAdaptiveRuntimeSettingsCommand}" />
                                    <Button Content="Generate question now" Command="{Binding RequestAdaptiveQuestionNowCommand}" />
                                    <Button Content="Activate guided learning" Command="{Binding ActivateGuidedLearningCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#121C30" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Pending adaptive question" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PendingAdaptiveBusinessQuestion.Prompt}" Foreground="#DCE7FA" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Select all options that apply:" Foreground="#9FB2D2" />
                                <ItemsControl ItemsSource="{Binding PendingAdaptiveBusinessQuestion.Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Content="{Binding}"
                                                Checked="AdaptiveOption_Checked"
                                                Unchecked="AdaptiveOption_Unchecked"
                                                Margin="0,2,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox
                                    Header="Optional freeform context"
                                    Text="{Binding AdaptiveFreeformResponseDraft, Mode=TwoWay}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="88" />
                                <TextBlock Text="{Binding AdaptiveSelectedOptionsLine}" Foreground="#9FB2D2" TextWrapping="WrapWholeWords" />
                                <Button Content="Submit response" Command="{Binding SubmitAdaptiveQuestionResponseCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="World Monitor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#121C30" CornerRadius="12" Padding="14" Margin="0,6,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,12,0">
                                <TextBlock Text="World Monitor integration" Foreground="#F4F7FC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Embed the worldmonitor-main dashboard directly in Atlas. Use hosted mode or point to your local dev server." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                <TextBox Header="World Monitor URL" Text="{Binding WorldMonitorUrlDraft, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Load URL" Command="{Binding ApplyWorldMonitorUrlCommand}" />
                                    <Button Content="Use Hosted" Command="{Binding UseHostedWorldMonitorCommand}" />
                                    <Button Content="Use Local Dev" Command="{Binding UseLocalWorldMonitorCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding WorldMonitorStatusLine}" Foreground="#9AB0CF" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Local dev tip: in /Users/avrohom/Downloads/BlackHaven/worldmonitor-main run npm install, then npm run dev." Foreground="#8397B9" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#10192D" CornerRadius="10" Padding="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Nature + wildlife indicators" Foreground="#F4F7FC" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="Critical sources to keep biodiversity, habitat, fire, and climate risk visible during planning." Foreground="#C8D6EE" TextWrapping="WrapWholeWords" />
                                        <HyperlinkButton Content="IUCN Red List (threatened species portal)" NavigateUri="https://www.iucnredlist.org/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="IUCN Red List API (token required)" NavigateUri="https://api.iucnredlist.org/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="GBIF species data portal" NavigateUri="https://www.gbif.org/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="GBIF API" NavigateUri="https://api.gbif.org/v1/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="Protected Planet (WDPA)" NavigateUri="https://www.protectedplanet.net/en" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="Global Forest Watch" NavigateUri="https://www.globalforestwatch.org/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="NASA FIRMS active fire data" NavigateUri="https://firms.modaps.eosdis.nasa.gov/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="NOAA Climate at a Glance" NavigateUri="https://www.ncei.noaa.gov/access/monitoring/climate-at-a-glance/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="Copernicus Climate Bulletins" NavigateUri="https://climate.copernicus.eu/climate-bulletins" HorizontalAlignment="Left" />

                                        <Rectangle Height="1" Fill="#263753" Margin="0,4,0,4" />

                                        <TextBlock Text="Charity impact monitor" Foreground="#F4F7FC" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="Track charity progress, gaps, funding needs, and external accountability signals." Foreground="#C8D6EE" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="Recommended scorecard dimensions: impact trend, governance risk, financial runway, and unmet funding gap." Foreground="#AFC2E0" TextWrapping="WrapWholeWords" />
                                        <HyperlinkButton Content="Charity Navigator (search + profiles)" NavigateUri="https://www.charitynavigator.org/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="Charity Navigator Data API portal" NavigateUri="https://developer.charitynavigator.org/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="Charity Navigator GraphQL API product page" NavigateUri="https://www.charitynavigator.org/products-and-services/graphql-api/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="Charity Navigator ratings methodology" NavigateUri="https://www.charitynavigator.org/about-us/our-methodology/ratings/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="IRS Tax Exempt Organization Search" NavigateUri="https://apps.irs.gov/app/eos/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="ProPublica Nonprofit Explorer (990s)" NavigateUri="https://projects.propublica.org/nonprofits/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="Candid (GuideStar) organization profiles" NavigateUri="https://www.guidestar.org/" HorizontalAlignment="Left" />
                                        <HyperlinkButton Content="GiveWell top charities" NavigateUri="https://www.givewell.org/charities/top-charities" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#121C30" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Nature Signal Stack v2" Foreground="#F4F7FC" FontSize="18" FontWeight="SemiBold" />
                                <Button Content="Refresh now" Command="{Binding RefreshNatureSignalStackCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding NatureRiskLine}" Foreground="#DCE7FA" />
                            <TextBlock Text="{Binding NatureThresholdLine}" Foreground="#9FB2D2" />
                            <TextBlock Text="{Binding NatureAlertSummary}" Foreground="#BFD0EB" TextWrapping="WrapWholeWords" />
                            <ListView ItemsSource="{Binding NatureSignalTiles}" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:NatureSignalTile">
                                        <Border Background="#10192D" CornerRadius="8" Margin="0,3,0,3" Padding="10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Title}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Metric}" Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Trend}" Foreground="#9AB0CF" />
                                                    <TextBlock Text="{x:Bind Severity}" Foreground="#9AB0CF" />
                                                    <TextBlock Text="{x:Bind SourceLabel}" Foreground="#8FB1FF" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="#10192D" CornerRadius="12" Padding="4">
                        <WebView2 Source="{Binding WorldMonitorUri}" />
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="System Output">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Border Grid.Row="0" Background="#0E1A2B" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding LocalModelRuntimeStatus}" Foreground="#F4F7FC" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LocalModelRuntimeDetail}" Foreground="#BFD0EB" TextWrapping="WrapWholeWords" />
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding LocalModelRuntimeProgress}" Height="8" Foreground="#44C7FF" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LocalModelDownloadSizeText}" Foreground="#9FB2D2" />
                                <TextBlock Text="  •  " Foreground="#7F95B7" />
                                <TextBlock Text="{Binding LocalModelDownloadEtaText}" Foreground="#9FB2D2" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding SystemOutput}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SystemLogLine">
                                <Border Background="#10192D" CornerRadius="10" Margin="0,4,0,4" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind CreatedAt}" Foreground="#8DA4C7" FontSize="12" />
                                        <TextBlock Text="{x:Bind Text}" Foreground="#DCE7FA" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>

        <Border
            Grid.RowSpan="2"
            Background="#A6121C30"
            Visibility="{x:Bind BoolVisibility(ViewModel.ShowRemoteTransferTutorial), Mode=OneWay}">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760" Margin="24">
                <Border Background="#10192D" CornerRadius="18" Padding="24">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Your desktop is now the local home base" Foreground="#F4F7FC" FontSize="28" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="BlackHaven is built so a phone can push work and files back to the desktop you already own while that machine stays on and plugged in, even when internet service is degraded or unavailable." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="What this means:" Foreground="#F4F7FC" FontWeight="SemiBold" />
                        <TextBlock Text="1. Pair your phone to this desktop with the local URL and pairing token in Command Center." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="2. Keep the destination on your own machine instead of a hosted relay whenever your local network is available, including emergency or internet-down situations." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="3. Run energy-intensive local AI on infrastructure you control, including the grid, home solar, portable panels, battery systems, or small wind." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="4. Use BlackHaven as an emergency prepping and management tool that stays useful when internet access drops but local power and local networking remain available." Foreground="#D0DBEF" TextWrapping="WrapWholeWords" />
                        <Border Background="#162742" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Why this matters" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                <TextBlock Text="Local-first design lets you control the energy source, keep sensitive work closer to home, and sustain heavy long-term AI workloads with backup power plus renewable generation. That makes BlackHaven more useful for resilience planning, outage response, and continuity operations." Foreground="#BFD0EB" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                        <Border Background="#1A314F" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suggested power strategy" Foreground="#F4F7FC" FontWeight="SemiBold" />
                                <TextBlock Text="We recommend pairing renewable energy generation with home backup power so this desktop can stay available for local AI and emergency coordination. Founder recommendation: EcoFlow Delta Pro 3." Foreground="#BFD0EB" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="I understand" Command="{Binding DismissRemoteTransferTutorialCommand}" />
                            <TextBlock Text="The Desktop Remote Control section below has the pairing URL and token." Foreground="#9AB0CF" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
